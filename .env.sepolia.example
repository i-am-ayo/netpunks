# Copy with: npm run sepolia:setup. Keep the real file on this machine only.
APP_NETWORK=sepolia
PORT=3002
HOST=127.0.0.1
WEB_PORT=5174

# Private RPC endpoint, used by the deployer and Express only.
SEPOLIA_RPC_URL=
# A NEW test-only wallet private key (0x + 64 hex digits). Never use a Hardhat demo key.
SEPOLIA_PRIVATE_KEY=
# Public endpoint shared with browser wallets; never put a provider API key here.
SEPOLIA_WALLET_RPC_URL=https://rpc.sepolia.org

# Final immutable base URI, ending in /. tokenURI = base + ID (no .json suffix).
# Example shapes: ipfs://METADATA_DIRECTORY_CID/ or https://your-domain/api/metadata/
SEPOLIA_METADATA_BASE_URL=
# Only needed when serving metadata/images from Express on a public HTTPS domain.
PUBLIC_BASE_URL=

# Lower this if your RPC plan limits eth_getLogs block ranges.
RPC_LOG_BLOCK_RANGE=100
SEPOLIA_CONFIRMATIONS=2

# Final public image directory used by npm run export:assets.
IMAGE_BASE_URL=
